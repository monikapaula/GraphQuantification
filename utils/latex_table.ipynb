    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"def final_table(dataframe):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    pivot_df = dataframe.pivot_table(\\\\n\\\",\\n\",\n",
    "    \"    \\\"        index=['Dataset', 'Split', 'Classifier'],\\\\n\\\",\\n\",\n",

    "    \"    \\\"    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"    pivot_df.columns = pivot_df.columns.swaplevel(0, 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    order = ['CC', 'ACC', 'PCC', 'PACC', 'KDEy', 'SIS-ACC', 'SIS-PACC']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    methods = [m for m in order if m in pivot_df.columns.levels[0]]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    pivot_df = pivot_df.reindex(columns=methods, level=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    pivot_df = pivot_df.reindex(columns=['MAE', 'KL'], level=1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    classifier_order = ['MLP', 'GCN', 'SAGE']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    classifiers = [c for c in classifier_order if c in pivot_df.index.levels[2]]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    pivot_df = pivot_df.reindex(classifiers, level='Classifier')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    formatted_df = pivot_df.copy().astype(str)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for label, group_indices in pivot_df.groupby(level=['Dataset', 'Split']).groups.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            for col in pivot_df.columns:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                values = pivot_df.loc[group_indices, col]\\\\n\\\",\\n\",\n",
    "    \"    \\\"                min_val = values.min()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                for idx in group_indices:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    val = pivot_df.loc[idx, col]\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    f_val = f\\\\\\\"{val:.4f}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    if val == min_val:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        formatted_df.loc[idx, col] = f\\\\\\\"\\\\\\\\\\\\\\\\textbf{{{f_val}}}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        formatted_df.loc[idx, col] = f_val\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    methods = formatted_df.columns.levels[0]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    num_methods = len(methods)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    column_def = \\\\\\\"ll\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    header_cells = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for i, m in enumerate(methods):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        is_last = (i == num_methods - 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        column_def += \\\\\\\"|cc\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        header_align = \\\\\\\"c\\\\\\\" if is_last else \\\\\\\"c|\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        header_cells.append(f\\\\\\\"\\\\\\\\\\\\\\\\multicolumn{{2}}{{{header_align}}}{{\\\\\\\\\\\\\\\\textbf{{{m}}}}}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    header_row_1 = \\\\\\\" & & \\\\\\\" + \\\\\\\" & \\\\\\\".join(header_cells) + r\\\\\\\" \\\\\\\\\\\\\\\\\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    metrics_cells = [\\\\\\\"MAE & KL\\\\\\\"] * num_methods\\\\n\\\",\\n\",\n",
    "    \"    \\\"    header_row_2 = r\\\\\\\"\\\\\\\\textbf{Split} & \\\\\\\\textbf{Classifier} & \\\\\\\" + \\\\\\\" & \\\\\\\".join(metrics_cells) + r\\\\\\\" \\\\\\\\\\\\\\\\\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    latex_body_lines = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"    total_cols = 2 + (num_methods * 2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for dataset_name, group in formatted_df.groupby(level=0, sort=False):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if latex_body_lines:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            latex_body_lines.append(r\\\\\\\"\\\\\\\\midrule\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        section_header = f\\\\\\\"\\\\\\\\\\\\\\\\multicolumn{{{total_cols}}}{{l}}{{\\\\\\\\\\\\\\\\textbf{{{dataset_name}}}}} \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        latex_body_lines.append(section_header)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        latex_body_lines.append(r\\\\\\\"\\\\\\\\midrule\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        sub_df = group.droplevel(0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        chunk_latex = sub_df.to_latex(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            header=False,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            index=True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            index_names=False,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            multirow=True,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            column_format=None,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            escape=False\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        lines = chunk_latex.splitlines()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        clean_lines = [l for l in lines if \\\\\\\"tabular\\\\\\\" not in l and \\\\\\\"rule\\\\\\\" not in l]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        latex_body_lines.extend(clean_lines)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    final_body = \\\\\\\"\\\\\\\\n\\\\\\\".join(latex_body_lines)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    latex_code = f\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
